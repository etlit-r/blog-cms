{
  "name": "blog-cms",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --infer-origin-from-routes=false",
    "dev:admin": "vite --config admin/vite.config.ts",
    "build": "vite build --config admin/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p admin/tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply blog-cms --local",
    "db:migrate:remote": "wrangler d1 migrations apply blog-cms --remote",
    "deploy": "npm run build && wrangler d1 migrations apply blog-cms --remote && wrangler deploy",
    "dev:worker": "wrangler dev --infer-origin-from-routes=false"
  },
  "dependencies": {
    "hono": "^4.13.18",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "^5.20261115.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  }
}
