{
  "name": "blog-cms",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --infer-origin-from-routes=false",
    "dev:admin": "vite --config admin/vite.config.ts",
    "build": "vite build --config admin/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p admin/tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply blog-cms --local",
    "db:migrate:remote": "wrangler d1 migrations apply blog-cms --remote",
    "deploy": "npm run build && wrangler d1 migrations apply blog-cms --remote && wrangler deploy",
    "dev:worker": "wrangler dev --infer-origin-from-routes=false"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "codemirror": "^6.0.2",
    "hono": "^4.13.18",
    "mustache": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "^5.20261115.1",
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  }
}
